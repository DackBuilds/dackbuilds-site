---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const is = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Dack Builds, home">
      <img src="/brand/favicon.svg" width="40" height="40" alt="" />
      <span class="wordmark">dack<span>builds</span></span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/" aria-current={is('/') || is('/posts') ? 'page' : undefined}>Home</a>
      <a href="/about" aria-current={is('/about') ? 'page' : undefined}>About</a>
      <a href="/rss.xml">RSS</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
